# Copy to .env for local development only (.env is git-ignored). NEVER commit a real key.
AI_API_KEY=
# Optional overrides (see config/model.yaml):
AI_MODEL=
AI_BASE_URL=
AI_PROVIDER=
# 1 = force plain-text actions, 0 = force native tool calls (default: auto-probe)
AI_TEXT_MODE=
# Optional: raises GitHub API rate limits when fetching issues
GITHUB_TOKEN=
